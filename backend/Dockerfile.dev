# IntelliDoc 백엔드 개발용 Dockerfile
FROM python:3.11-slim

# 빌드 인수
ARG DEV_MODE=false

# 작업 디렉토리 설정
WORKDIR /app

# 시스템 패키지 업데이트 및 필요한 도구 설치
RUN apt-get update && apt-get install -y \
    # 기본 도구
    curl \
    wget \
    git \
    vim \
    htop \
    # OCR 관련 (Tesseract)
    tesseract-ocr \
    tesseract-ocr-kor \
    tesseract-ocr-eng \
    libtesseract-dev \
    # 이미지 처리
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    # PDF 처리
    poppler-utils \
    # 데이터베이스 관련
    libpq-dev \
    # 빌드 도구 (개발용)
    gcc \
    g++ \
    make \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Python 의존성 설치
COPY requirements.txt /app/
COPY requirements-dev.txt /app/ 2>/dev/null || true

# pip 업그레이드 및 의존성 설치
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# 개발 모드인 경우 개발 의존성 설치
RUN if [ "$DEV_MODE" = "true" ] && [ -f requirements-dev.txt ]; then \
        pip install --no-cache-dir -r requirements-dev.txt; \
    fi

# 개발용 추가 도구 설치
RUN if [ "$DEV_MODE" = "true" ]; then \
        pip install --no-cache-dir \
        ipython \
        jupyter \
        pytest-watch \
        python-dotenv \
        watchdog; \
    fi

# 업로드 디렉토리 생성
RUN mkdir -p /app/uploads /app/logs /app/temp

# 권한 설정
RUN chmod 755 /app/uploads /app/logs /app/temp

# 개발 환경용 설정
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# 개발용 포트 노출
EXPOSE 8000

# 헬스체크 (개발용)
HEALTHCHECK --interval=30s --timeout=30s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# 개발용 엔트리포인트
COPY docker/dev_entrypoint.sh /app/dev_entrypoint.sh
RUN chmod +x /app/dev_entrypoint.sh

# 소스 코드 복사 (개발용 - 볼륨 마운트로 덮어씌워짐)
COPY . /app/

# 기본 명령어 (개발용)
CMD ["/app/dev_entrypoint.sh"]
